#include <SPI.h>
#include <LoRa.h>
#include <Wire.h>
#include <MPU6050.h>
#include <DHT.h>

// ==========================================
// 1. PIN DEFINITIONS & CONSTANTS
// ==========================================
#define LORA_SS 5
#define LORA_RST 14
#define LORA_DIO0 2
#define LORA_FREQ 433E6 // Change to 868E6 or 915E6 based on your region

#define MPU_SDA 21
#define MPU_SCL 22

#define DHT_PIN 4
#define DHT_TYPE DHT22

#define BUZZER_PIN 15
#define BUTTON_PIN 13

// Worker Identity (Change this for each wearable)
const String WORKER_ID = "W-001";

// Timing Constants (in milliseconds)
const unsigned long INACTIVITY_TIMEOUT = 120000; // 2 minutes of no movement
const unsigned long CONFIRMATION_WINDOW = 30000;  // 30 seconds to press button after alert
const unsigned long REPETITIVE_ALERT_INTERVAL = 3600000; // 1 hour

// ==========================================
// 2. OBJECT INITIALIZATION
// ==========================================
MPU6050 mpu;
DHT dht(DHT_PIN, DHT_TYPE);

// System States
enum WorkerState {
  STATE_NORMAL,
  STATE_INACTIVITY_ALERT,
  STATE_FALL_ALERT,
  STATE_SOS_ALERT
};

WorkerState currentState = STATE_NORMAL;
unsigned long lastMovementTime = 0;
unsigned long alertStartTime = 0;
unsigned long lastRepetitiveAlert = 0;

// Sensor Data Variables
float currentTemp = 0.0;
float currentHumidity = 0.0;
bool fallDetected = false;

// ==========================================
// 3. SETUP
// ==========================================
void setup() {
  Serial.begin(115200);
  while (!Serial);

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(BUTTON_PIN, INPUT_PULLUP);

  // Initialize DHT22
  dht.begin();

  // Initialize MPU6050
  Wire.begin(MPU_SDA, MPU_SCL);
  mpu.initialize();
  if (!mpu.testConnection()) {
    Serial.println("MPU6050 connection failed!");
  }

  // Initialize LoRa
  LoRa.setPins(LORA_SS, LORA_RST, LORA_DIO0);
  if (!LoRa.begin(LORA_FREQ)) {
    Serial.println("LoRa init failed. Check wiring.");
    while (1);
  }
  Serial.println("LoRa Initialized OK!");

  lastMovementTime = millis();
  Serial.println("Wearable Firmware Started. Worker ID: " + WORKER_ID);
}

// ==========================================
// 4. MAIN LOOP
// ==========================================
void loop() {
  readSensors();
  handleStateMachine();
  checkButton();
  delay(100); // Small delay to prevent CPU hogging
}

// ==========================================
// 5. SENSOR READING FUNCTIONS
// ==========================================
void readSensors() {
  // --- Read DHT22 ---
  float t = dht.readTemperature();
  float h = dht.readHumidity();
  if (!isnan(t) && !isnan(h)) {
    currentTemp = t;
    currentHumidity = h;
  }

  // --- Read MPU6050 ---
  int16_t ax, ay, az, gx, gy, gz;
  mpu.getMotion6(&ax, &ay, &az, &gx, &gy, &gz);

  // Calculate total acceleration (in g's)
  float accelMagnitude = sqrt(sq(ax) + sq(ay) + sq(az)) / 16384.0;

  // --- Fall Detection Algorithm ---
  // A fall is typically characterized by a sudden spike in acceleration (> 2.5g)
  if (accelMagnitude > 2.5 && currentState == STATE_NORMAL) {
    triggerAlert(STATE_FALL_ALERT, "Fall Detected");
  }

  // --- Inactivity Detection ---
  // Check if there is significant movement. Thresholds depend on sensor placement.
  if (abs(ax) > 3000 || abs(ay) > 3000 || abs(az) > 3000 || abs(gx) > 5000 || abs(gy) > 5000 || abs(gz) > 5000) {
    lastMovementTime = millis(); // Reset inactivity timer on movement
  }

  // --- Repetitive Movement Detection (Simplified) ---
  // In a real scenario, you'd track specific joint angles over time.
  // Here we simulate it with a time-based reminder if the worker is active.
  if (millis() - lastRepetitiveAlert > REPETITIVE_ALERT_INTERVAL && currentState == STATE_NORMAL) {
    beepBuzzer(2, 200); // Short double beep
    sendLoRaPacket("Ergonomic Alert: Time for a stretch break.");
    lastRepetitiveAlert = millis();
  }
}

// ==========================================
// 6. STATE MACHINE
// ==========================================
void handleStateMachine() {
  switch (currentState) {
    case STATE_NORMAL:
      // Check for prolonged inactivity
      if (millis() - lastMovementTime > INACTIVITY_TIMEOUT) {
        triggerAlert(STATE_INACTIVITY_ALERT, "Inactivity Detected");
      }
      break;

    case STATE_INACTIVITY_ALERT:
    case STATE_FALL_ALERT:
      // We are in an alert state. Wait for button press.
      if (millis() - alertStartTime > CONFIRMATION_WINDOW) {
        // Worker failed to respond. Send SOS to dashboard.
        currentState = STATE_SOS_ALERT;
        String msg = "CRITICAL: Worker " + WORKER_ID + " unresponsive. Last state: " + 
                     (currentState == STATE_FALL_ALERT ? "Fall" : "Inactivity");
        sendLoRaPacket(msg);
        beepBuzzer(5, 100); // Continuous alarm
      }
      break;

    case STATE_SOS_ALERT:
      // Keep sending SOS until reset (or handle via dashboard)
      // In a real system, you might reset this after a timeout.
      break;
  }
}

// ==========================================
// 7. BUTTON HANDLING
// ==========================================
void checkButton() {
  // Button is active LOW (pressed = LOW)
  if (digitalRead(BUTTON_PIN) == LOW) {
    delay(50); // Debounce
    if (digitalRead(BUTTON_PIN) == LOW) {
      
      if (currentState == STATE_NORMAL) {
        // Manual SOS Triggered
        triggerAlert(STATE_SOS_ALERT, "Manual SOS Triggered");
        sendLoRaPacket("SOS: Worker " + WORKER_ID + " pressed the panic button!");
        
      } else if (currentState == STATE_INACTIVITY_ALERT || currentState == STATE_FALL_ALERT) {
        // Worker confirmed they are OK
        currentState = STATE_NORMAL;
        lastMovementTime = millis(); // Reset timer
        noTone(BUZZER_PIN);
        sendLoRaPacket("OK: Worker " + WORKER_ID + " confirmed they are safe.");
      }
      
      // Wait for button release to avoid multiple triggers
      while(digitalRead(BUTTON_PIN) == LOW) { delay(10); }
    }
  }
}

// ==========================================
// 8. HELPER FUNCTIONS
// ==========================================
void triggerAlert(WorkerState newState, String reason) {
  currentState = newState;
  alertStartTime = millis();
  
  // Start buzzing to get worker's attention
  beepBuzzer(3, 500); // 3 long beeps
  
  // Log locally
  Serial.println("ALERT: " + reason);
}

void beepBuzzer(int times, int duration) {
  for (int i = 0; i < times; i++) {
    tone(BUZZER_PIN, 1000); // 1kHz tone
    delay(duration);
    noTone(BUZZER_PIN);
    delay(100);
  }
}

void sendLoRaPacket(String message) {
  String payload = WORKER_ID + "|" + message;
  
  LoRa.beginPacket();
  LoRa.print(payload);
  LoRa.endPacket();
  
  Serial.println("LoRa Sent: " + payload);
}
